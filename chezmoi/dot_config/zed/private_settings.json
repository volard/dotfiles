// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "format_on_save": "off",
  "diff_view_style": "unified",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "languages": {
    "JavaScript": {
      "format_on_save": "off"
    },
    "Python": {
      "format_on_save": "off"
    }
  },
  "cli_default_open_behavior": "existing_window",
  "edit_predictions": {
    "allow_data_collection": "no",
    "mode": "eager"
  },
  "agent_servers": {
    "opencode": {
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "medium",
        "mode": "agent-full-access"
      },
      "type": "registry"
    }
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "default_model": {
      "provider": "zed.dev",
      "model": "gpt-5.6-sol",
      "enable_thinking": true,
      "effort": "medium"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "fallback_branch_name": "main",
    "tree_view": true,
    "dock": "left"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true,
  "scrollbar": {
    "show": "never"
  },
  // File syntax highlighting
  "file_types": {
    "Dockerfile": ["Dockerfile", "Dockerfile.*"],
    "JSON": ["json", "jsonc", "*.code-snippets"]
  },
  "project_panel": {
    "dock": "left",
    "git_status": true
  },
  "auto_install_extensions": {
    "just": true,
    "dockerfile": true,
    "docker-compose": true,
    "material-icon-theme": true,
    "catppuccin": true,
    "editorconfig": true,
    "ini": true,
    "log": true,
    "nix": true,
    "terraform": true,
    "kotlin": true,
    "dart": true
  },
  // Which-key popup settings
  "which_key": {
    // Whether to show the which-key popup when holding down key combinations.
    "enabled": true,
    // Delay in milliseconds before showing the which-key popup.
    "delay_ms": 1000
  },
  "hide_mouse": "on_typing_and_action",
  "gutter": {
    "line_numbers": false
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Material Icon Theme"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Catppuccin Mocha"
  }
}
