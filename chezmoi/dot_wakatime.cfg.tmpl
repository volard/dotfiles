{{- $secretsFile := joinPath .chezmoi.sourceDir "encrypted_secrets.yaml.age" -}}
{{- $secrets := dict -}}
{{- if stat $secretsFile -}}
{{- $secrets = $secretsFile | include | decrypt | fromYaml -}}
{{- end -}}
{{- $wakatimeApiKey := env "WAKATIME_API_KEY" -}}
{{- with index $secrets "wakatime_api_key" -}}
{{- $wakatimeApiKey = . -}}
{{- end }}
[settings]
debug=false
api_url = https://wakapi.dev/api
api-key = {{ $wakatimeApiKey }}
exclude = 
    COMMIT_EDITMSG$
    PULLREQ_EDITMSG$
    MERGE_MSG$
    TAG_EDITMSG$
    .*\.cfg$
    .*\.conf$
    .*\.md$
    .*\.json$
    .*\.config$
    .*telescope.*
    telescope://.*
    TelescopePrompt.*
    TelescopeResults.*
    tsconfig
    gitignore
    checkhealth
    **/*.md$
    **/*.txt$
    .*\.ini$
    .*\.txt$
    go.sum
    .*\.yaml$
    .*\.yml$
    .*\.toml$
    .*\.env.*
    filename=neo-tree*
